[Unit]
Description=Locksmith forwarder for Incus agents VMs (to Locksmith over the tailnet)
Requires=agents-locksmith-forward.socket
After=agents-locksmith-forward.socket tailscaled.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=64 {{ agents_guard.locksmith_forward.upstream_ip }}:{{ agents_guard.locksmith_forward.upstream_port }}
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow={{ agents_guard.bridge_cidr }} {{ agents_guard.locksmith_forward.upstream_ip }}
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
