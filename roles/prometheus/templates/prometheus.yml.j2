# Generated by openclaw-deploy ansible
global:
  scrape_interval: {{ telemetry.prometheus.scrape_interval }}
  evaluation_interval: {{ telemetry.prometheus.scrape_interval }}

scrape_configs:
  # OTel Collector's Prometheus exporter (all service metrics flow here)
  - job_name: "otel-collector-metrics"
    static_configs:
      - targets: ["{{ telemetry.host }}:8889"]
        labels:
          source: "otel-collector"

  # OTel Collector's own internal metrics
  - job_name: "otel-collector-internal"
    static_configs:
      - targets: ["{{ telemetry.host }}:8898"]
        labels:
          source: "otel-collector-internal"

  # Prometheus self-monitoring
  - job_name: "prometheus"
    static_configs:
      - targets: ["{{ telemetry.host }}:{{ telemetry.prometheus.port }}"]
{% if telemetry.prometheus.node_exporter.listen is defined and (telemetry.prometheus.node_exporter.scrape | default(true)) %}

  # Host metrics from the node exporter this role installs
  - job_name: "node"
    static_configs:
      - targets: ["{{ telemetry.prometheus.node_exporter.listen }}"]
{% endif %}
{% if telemetry.prometheus.extra_scrape_configs | default([]) | length > 0 %}

  # Site-defined jobs (telemetry.prometheus.extra_scrape_configs)
{{ telemetry.prometheus.extra_scrape_configs | to_nice_yaml(indent=2) | indent(2, first=true) }}
{%- endif %}
